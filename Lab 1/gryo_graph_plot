from serial import Serial
import matplotlib.pyplot as plt
import time

# Connect to Arduino
ser = Serial('COM5', 9600)

# Turn on interactive plotting
plt.ion()

# Create graph
fig, ax = plt.subplots()

ax.set_title('Gyroscope Tilt')
ax.set_xlabel('Time (s)')
ax.set_ylabel('Angle (Degrees)')

# Set fixed y-axis range
ax.set_ylim(-20, 20)

# Store graph data
x_data = []
gyro_data = []   # Gyroscope angle

# Create two lines with labels
line_gyro, = ax.plot(x_data, gyro_data, color='blue')

ax.legend()

start_time = time.time()  # Record start time

while True:
    try:
        # Read serial data
        data = ser.readline().decode().strip()

        gyro_angle = float(data)

        elapsed = time.time() - start_time  # Seconds since start

        # Add new data points
        x_data.append(elapsed)
        gyro_data.append(gyro_angle)

        # Update both graph lines
        line_gyro.set_data(x_data, gyro_data)

        # Move x-axis as data grows
        ax.set_xlim(0, elapsed + 1)

        # Redraw graph
        fig.canvas.draw()
        fig.canvas.flush_events()

    except KeyboardInterrupt:
        ser.close()
        break